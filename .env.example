# Copiaza in .env si completeaza; .env nu ajunge niciodata in git

# Server web
# Fisierele compose incarcate; pe server se lasa doar compose.yaml
COMPOSE_FILE=compose.yaml:compose.dev.yaml
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# Baza de date
DB_HOST=db
DB_PORT=3306
DB_NAME=revista_online
DB_USER=revista
DB_PASS=schimba_parola
DB_ROOT_PASS=schimba_parola_root

# Aplicatie
# Doar valoarea "local" afiseaza erorile in pagina; pe server se lasa altceva
APP_ENV=local
APP_URL=http://localhost:8080

# Sare pentru hash-ul IP-urilor din statistici. Se poate genera cu: openssl rand -hex 32
ANALYTICS_SALT=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# SMTP - formularul de contact
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Adresa redactiei: aici ajung mesajele din formularul de contact
CONTACT_EMAIL=

# reCAPTCHA - formularele publice
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
